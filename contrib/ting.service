[Unit]
Description=Ting node agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ting
Group=ting
# The agent needs the shared staging group. This unit still runs the harness as ting
# unless a profile wrapper starts a separate-account runner; workspace_group only
# shares the working tree, not the agent's token.
SupplementaryGroups=lu-harness
WorkingDirectory=/var/lib/ting/work
# Adjust the binary path if PREFIX was not /usr/local. The [agent] table is kept in
# the renamed config; see contrib/ting.toml.
ExecStart=/usr/local/bin/ting --config /etc/ting/ting.toml
SyslogIdentifier=ting
Restart=on-failure
RestartSec=5s
TimeoutStopSec=40s
KillMode=mixed
StateDirectory=ting
StateDirectoryMode=0750
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Do not add MemoryDenyWriteExecute here: a JavaScript/Bun/Node harness needs
# executable mappings for its JIT. Set it only for a harness that does not.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
# Staging, checkouts and optional [log] file under /var/lib/ting; the harness home
# is writable by the child process in the same sandbox.
ReadWritePaths=/var/lib/ting /var/lib/lu-harness
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
